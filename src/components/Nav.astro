---
const path = Astro.url.pathname;
const isResume = path === '/resume' || path === '/resume/';
---

<nav class="flex justify-start smallcaps">
  {
    isResume ? (
      <a href="/" class="text-base hover:underline underline-offset-4">← Home</a>
    ) : (
      <span class="text-base" aria-hidden="true">&nbsp;</span>
    )
  }
</nav>
