---
const links = [
  { label: 'GitHub', href: 'https://github.com/alexlayton', external: true },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/alex-layton-a0947361', external: true },
  { label: 'Email', href: 'mailto:hi@alexlayton.co', external: false },
  { label: 'Resume', href: '/resume', external: false },
];
---

<ul class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-lg">
  {
    links.map(link => (
      <li>
        <a
          href={link.href}
          class="underline decoration-1 underline-offset-4 hover:no-underline"
          {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
