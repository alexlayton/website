---
import Base from '../layouts/Base.astro';
---

<Base title="Resume — Alex Layton" description="Resume of Alex Layton, software engineer." background={false}>
  <main>
    <header>
      <h1 class="text-2xl font-bold tracking-[0.08em]">ALEX LAYTON</h1>
      <p class="mt-2 text-sm">
        Software engineer · Connected products, systems architecture and technical leadership
      </p>
    </header>

    <section class="mt-8">
      <h2 class="font-accent text-sm font-normal uppercase tracking-widest border-b border-black dark:border-neutral-100 pb-1 mb-4">
        Profile
      </h2>
      <p class="text-sm leading-relaxed">
        Software engineer with over twelve years of experience across mobile, cloud and
        embedded systems. I take new connected product features from proof of concept
        through architecture and reusable components to adoption by delivery teams.
        I combine hands-on engineering with cross-team technical leadership and mentoring.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="font-accent text-sm font-normal uppercase tracking-widest border-b border-black dark:border-neutral-100 pb-1 mb-4">
        Experience
      </h2>

      <article class="mb-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
          <h3 class="font-bold">Dyson</h3>
          <span class="text-sm">2017 — Present</span>
        </div>
        <p class="text-sm italic">
          Associate Principal Software Engineer · previously Lead, Senior and Software Engineer
        </p>
        <p class="mt-2 text-sm leading-relaxed">
          Software engineering and technical leadership in a cross-disciplinary innovation
          team, bringing mobile, embedded and cloud engineering together to explore new
          connected product features and help delivery teams ship them.
        </p>
        <ul class="mt-2 list-disc list-inside text-sm leading-relaxed space-y-1">
          <li>Defined the architecture for smart-home device setup, now used in production products, and delivered reusable mobile libraries for app teams.</li>
          <li>Co-developed a reusable 3D product-visualisation framework that ships in the customer app, and built map interaction concepts with robotics teams.</li>
          <li>Led a small app team on an air-quality monitoring project, with reliable background data sync between sensors, app and cloud.</li>
          <li>Built an internal app distribution platform and moved the team’s build and release automation to a managed CI/CD service.</li>
          <li>Built shared Swift libraries that let engineers prototype on production protocols and services, and mentored undergraduate engineers.</li>
        </ul>
      </article>

      <article class="mb-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
          <h3 class="font-bold">Mobile Developer</h3>
          <span class="text-sm">2014 — 2016</span>
        </div>
        <p class="text-sm italic">Ventutec</p>
        <p class="mt-2 text-sm leading-relaxed">
          Developed commercial iOS and Android apps for clients, and prototyped a
          Bluetooth-based IoT app and cloud platform.
        </p>
      </article>

      <article class="mb-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
          <h3 class="font-bold">Graduate Analyst Programmer</h3>
          <span class="text-sm">2013 — 2014</span>
        </div>
        <p class="text-sm italic">Graffica</p>
        <p class="mt-2 text-sm leading-relaxed">
          Developed airspace-planning software used across Europe and automated the
          software release process.
        </p>
      </article>
    </section>

    <section class="mt-8">
      <h2 class="font-accent text-sm font-normal uppercase tracking-widest border-b border-black dark:border-neutral-100 pb-1 mb-4">
        Education
      </h2>
      <article>
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline">
          <h3 class="font-bold">BSc Computer Science, First Class Honours</h3>
          <span class="text-sm">2010 — 2013</span>
        </div>
        <p class="text-sm">University of Birmingham</p>
      </article>
    </section>

    <section class="mt-8">
      <h2 class="font-accent text-sm font-normal uppercase tracking-widest border-b border-black dark:border-neutral-100 pb-1 mb-4">
        Skills
      </h2>
      <p class="text-sm leading-relaxed">
        <span class="font-bold">Focus:</span> Systems architecture, Technical leadership, Prototyping, Mentoring
        <br />
        <span class="font-bold">Languages:</span> Swift, Python, Rust, TypeScript, Go, Kotlin, C++
        <br />
        <span class="font-bold">Connected systems:</span> Bluetooth LE, Matter, HomeKit, MQTT, AWS IoT
        <br />
        <span class="font-bold">Platforms:</span> AWS, Docker, CI/CD, GitOps, SwiftUI, React
      </p>
    </section>

    <section class="mt-8">
      <h2 class="font-accent text-sm font-normal uppercase tracking-widest border-b border-black dark:border-neutral-100 pb-1 mb-4">
        Projects
      </h2>
      <article>
        <h3 class="font-bold">
          <a
            href="https://github.com/alexlayton/harness"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:underline underline-offset-4"
          >Harness</a>
        </h3>
        <p class="text-sm leading-relaxed">
          An open-source coding agent written in Rust. It works with several LLM
          providers, runs tools and subagents, and runs in the terminal, in headless
          mode or from an editor.
        </p>
      </article>
    </section>
  </main>
</Base>
