---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
---

<Base>
  <header class="mt-12">
    <h1 class="text-2xl font-bold tracking-[0.08em]">ALEX LAYTON</h1>
  </header>

  <main class="mt-10">
    <p class="leading-relaxed">
      A software engineer who takes ideas from first prototype to production.
      For over a decade I’ve built software across mobile, cloud and embedded
      systems — most of it at Dyson, where I provide technical leadership and
      architecture for new connected product features. I’m happiest where
      disciplines meet: turning ambiguous problems into clear designs and reusable
      tools that other teams can build on.
    </p>
    <p class="mt-6 leading-relaxed">
      Outside work, I’m building
      <a
        href="https://github.com/alexlayton/harness"
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 hover:no-underline"
      >Harness</a>, an open-source coding agent written in Rust.
    </p>

    <section class="mt-12">
      <SocialLinks />
    </section>
  </main>
</Base>
