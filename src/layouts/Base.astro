---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Fonts from '../components/Fonts.astro';
import GravityBackground from '../components/GravityBackground.astro';

interface Props {
  title?: string;
  description?: string;
  /** Show the animated background. Turn it off on pages made for reading. */
  background?: boolean;
}

const {
  title = 'Alex Layton',
  description = 'Personal website of Alex Layton, software engineer.',
  background = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <Fonts />
    <link rel="icon" href="data:;base64,iVBORw0KGgo=" />
    <title>{title}</title>
  </head>
  <body class="relative isolate min-h-screen bg-white text-black dark:bg-neutral-900 dark:text-neutral-100 font-mono antialiased">
    {background && <GravityBackground />}
    <div class="relative z-[1] mx-auto max-w-2xl px-6 py-12 md:py-20">
      <Nav />
      <slot />
    </div>
  </body>
</html>
