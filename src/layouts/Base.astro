---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alex Layton',
  description = 'Personal website of Alex Layton, software engineer.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="data:;base64,iVBORw0KGgo=" />
    <title>{title}</title>
  </head>
  <body class="bg-white text-black dark:bg-neutral-900 dark:text-neutral-100 font-mono antialiased">
    <div class="mx-auto max-w-2xl px-6 py-12 md:py-20">
      <Nav />
      <slot />
    </div>
  </body>
</html>
